{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/OneLight1688/duewall-adapters/profiles/schema.json",
  "title": "DueWall issuer profile v1",
  "description": "Declarative per-issuer config for the universal adapter runtime. One runtime, many profiles. See docs/PROFILE_SPEC.md.",
  "type": "object",
  "required": ["profile_version", "issuer", "engine", "mapping", "event_defaults"],
  "additionalProperties": false,
  "properties": {
    "profile_version": {"const": 1},
    "issuer": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "engine": {"enum": ["chain", "rest", "graphql"]},
    "display_name": {"type": "string"},
    "description": {"type": "string"},
    "event_defaults": {
      "type": "object",
      "required": ["verified_by", "source_type"],
      "additionalProperties": false,
      "properties": {
        "verified_by": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "source_type": {"enum": ["legal_doc", "announcement", "chain", "press"]}
      }
    },
    "chains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["rpc", "explorer"],
        "properties": {
          "rpc": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
          "explorer": {"type": "string"}
        }
      }
    },
    "contract": {
      "type": "object",
      "required": ["calls", "entities"],
      "properties": {
        "calls": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^0x[0-9a-f]{8}$"}
        },
        "entities": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "chain", "cdo", "aa"],
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "chain": {"type": "string"},
              "cdo": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
              "aa": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
              "bb": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
              "strategy": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
              "queue": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
              "escrow": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
              "entity_key": {"type": "string"},
              "borrower_type": {"type": "string"}
            }
          }
        }
      }
    },
    "rest": {
      "type": "object",
      "required": ["endpoint"],
      "properties": {
        "endpoint": {"type": "string", "format": "uri"},
        "list_path": {"type": "string"},
        "filter": {
          "type": "object",
          "required": ["field", "op"],
          "properties": {
            "field": {"type": "string"},
            "op": {"enum": ["contains_any", "eq", "gte"]},
            "values": {"type": "array", "items": {"type": "string"}},
            "value": {}
          }
        },
        "sort_by": {"type": "string"},
        "sort_desc": {"type": "boolean"},
        "limit": {"type": "integer", "minimum": 1}
      }
    },
    "graphql": {
      "type": "object",
      "required": ["endpoint", "query", "list_path"],
      "properties": {
        "endpoint": {"type": "string", "format": "uri"},
        "query": {"type": "string"},
        "list_path": {"type": "string"}
      }
    },
    "mapping": {
      "type": "object",
      "required": ["token", "source_url"],
      "properties": {
        "token": {"type": "string"},
        "source_url": {"type": "string"},
        "event_type": {"enum": ["maturity", "redemption_window", "nav_report", "maturity_resolution"]},
        "date": {},
        "date_confidence": {"enum": ["exact", "estimated", "unknown"]},
        "amount": {"type": "object"},
        "nav": {
          "type": "object",
          "required": ["call", "decimals"],
          "properties": {
            "call": {"type": "string"},
            "decimals": {"type": "integer", "minimum": 0, "maximum": 18},
            "fix_key": {"type": "string"},
            "assumption_template": {"type": "string"}
          }
        },
        "apr": {
          "type": "object",
          "required": ["call", "scale"],
          "properties": {
            "call": {"type": "string"},
            "scale": {"type": "number"},
            "precision": {"type": "integer"}
          }
        },
        "redemption_window": {
          "type": "object",
          "required": ["date_call", "running_call", "duration_call", "recurrence"],
          "properties": {
            "date_call": {"type": "string"},
            "running_call": {"type": "string"},
            "duration_call": {"type": "string"},
            "buffer_call": {"type": "string"},
            "window_fix_key": {"type": "string"},
            "recurrence": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["max_days", "label"],
                "properties": {
                  "max_days": {"type": "number", "exclusiveMinimum": 0},
                  "label": {"type": "string"}
                }
              }
            },
            "terms": {"type": "object"}
          }
        },
        "resolution": {
          "type": "object",
          "required": ["event_type", "state_field", "map"],
          "properties": {
            "event_type": {"const": "maturity_resolution"},
            "state_field": {"type": "string"},
            "date": {"type": "string"},
            "map": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "extra": {"type": "object"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"engine": {"const": "chain"}}},
      "then": {"required": ["chains", "contract"]}
    },
    {
      "if": {"properties": {"engine": {"const": "rest"}}},
      "then": {"required": ["rest"]}
    },
    {
      "if": {"properties": {"engine": {"const": "graphql"}}},
      "then": {"required": ["graphql"]}
    }
  ]
}
